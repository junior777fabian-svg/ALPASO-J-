<?xml version="1.0" encoding="utf-8"?>
<!-- Solo en compilaciones de depuración: permite hablar sin https con el
     servidor local de la laptop desde el emulador (10.0.2.2) o por
     adb reverse (127.0.0.1). Cualquier otro servidor exige https, y la
     compilación release no lleva este archivo. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
